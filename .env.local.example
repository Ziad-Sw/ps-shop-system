# Supabase — copy to .env.local and fill from your project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AUTH_SESSION_SECRET=your-long-random-session-secret

# Cron job — shared secret for invoking /api/cron/cleanup from external cron services.
CRON_SECRET=your-cron-secret-token
# Set to "true" to log what would be deleted without deleting anything.
CRON_DRY_RUN=true
